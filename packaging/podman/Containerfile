# StrixFold's userspace on AMD's ROCm image; the host provides the kernel driver, the GTT size and the USB4 network.
FROM docker.io/rocm/dev-ubuntu-26.04:10.1.0-full@sha256:4f5ed1bf6532a4b9920400401b0ad0f706af356dae61e40afefbfd6c8073f0ce

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget curl git rsync xz-utils bc \
      openssh-server openssh-client procps iproute2 iputils-ping less \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /run/sshd

# StrixFold loads libamdhip64.so.7 by name, and the image leaves /opt/rocm/lib off the linker path.
RUN echo /opt/rocm/lib > /etc/ld.so.conf.d/rocm.conf && ldconfig

# The image's uid 1000 "ubuntu" user goes, so --userns keep-id shows the host user by name to sshd and ssh.
RUN userdel -r ubuntu 2>/dev/null || true

# Python 3.13 for StrixFold's venvs (its input lock and Triton wheel are cp313); ROCm's own tools keep python3 3.14.
COPY --from=ghcr.io/astral-sh/uv:0.13.8@sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85 \
     /uv /usr/local/bin/uv
RUN UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_BIN_DIR=/usr/local/bin uv python install 3.13.18 \
    && python3.13 -c 'import sys, venv, ensurepip; assert sys.version_info[:3] == (3, 13, 18)'

# No systemd in a container: this systemd-run keeps a scope's CPU set (taskset) and runs the command.
COPY systemd-run /usr/local/bin/systemd-run
RUN chmod 755 /usr/local/bin/systemd-run
