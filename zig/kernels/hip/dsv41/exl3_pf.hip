/* w-pf's routed experts for prompt chunks on gfx1151 (exl3.pf_experts.*: exl3_experts.zig pfPlan / promptPf launch
 * them, hip_load.zig binds them). Kernel bodies by w-pf (p-pf): node0 ~/tfp/pf hip/pf_moe.hip at 60acf86 (sha256
 * 322ed900...), with the helpers of hip/w_core.cuh at the same commit; generated by node1 ~/tfp/exl3/tools/mkkit_pf.py.
 *
 * What the kernels do (pf_abi.h, abi.h tf_ds_exl3_pf_args): count / place group a chunk's picks by expert into jobs of
 * up to nm (64 or 128) rows; rot writes each pick's rotated gate and up input rows (fp16, sorted order) from x (bf16);
 * gu_<nm>_k<K2> runs the jobs of the experts whose gate K2 is K2: each wave decodes the two 16 x 16 tiles it multiplies
 * (exact MUL1) once per k tile for all the job's rows (v_wmma_f32_16x16x16_f16, fp32 accumulation), then H128 * svh,
 * DeepSeek's SwiGLU with its clamps, * suh_d, H128 into xd; down_<nm>_k<K2> likewise for down into z [pick, d] (H128
 * * svh_d); combine sums each row's slots in slot order as an fma chain of wts * z from 0. No split K, no atomics in
 * the sums: deterministic. Numerics: exl3.experts_grouped.
 *
 * Changes against pf_moe.hip: the engine form only (no TfDsExl3MoeArgs entries, no host launchers: the engine launches
 * the symbols with pf_abi.h's grids); abi.h's struct in place of TfDsExl3PfMoeArgs (same layout, lower-case names);
 * w_core.cuh's helpers inlined. Compiled with the kit's flags (-ffp-contract=off, IEEE denormals), not w-pf's. */
#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#include <stdint.h>
#include "abi.h"

namespace wcore {
typedef __attribute__((__vector_size__(16 * sizeof(__fp16)))) __fp16 f16x16;
typedef __attribute__((__vector_size__(8 * sizeof(float)))) float f32x8;
typedef _Float16 h2 __attribute__((ext_vector_type(2)));

constexpr float HAD_SCALE = 0.088388347648f;

// In-place unnormalised 128-point Walsh-Hadamard over a wave: lane holds elements 4 lane + i
__device__ __forceinline__ void fwht128(float* v, int lane)
{
    const float a0 = v[0] + v[1], a1 = v[0] - v[1], a2 = v[2] + v[3], a3 = v[2] - v[3];
    v[0] = a0 + a2; v[2] = a0 - a2; v[1] = a1 + a3; v[3] = a1 - a3;
    #pragma unroll
    for (int m = 1; m < 32; m <<= 1)
        #pragma unroll
        for (int i = 0; i < 4; ++i)
        {
            const float o = __shfl_xor(v[i], m);
            v[i] = (lane & m) ? (o - v[i]) : (v[i] + o);
        }
}

__device__ __forceinline__ half sat_half(float f) { return __float2half_rn(fminf(fmaxf(f, -65504.0f), 65504.0f)); }
__device__ __forceinline__ _Float16 sat_f16(float f) { return (_Float16) __half2float(sat_half(f)); }
__device__ __forceinline__ f16x16 load_afrag(const _Float16* row16)   // 16 contiguous halves (32-byte aligned)
{
    const uint4* p = reinterpret_cast<const uint4*>(row16);
    const uint4 lo = p[0], hi = p[1];
    const uint32_t w[8] = {lo.x, lo.y, lo.z, lo.w, hi.x, hi.y, hi.z, hi.w};
    f16x16 a;
    __builtin_memcpy(&a, w, 32);
    return a;
}

__device__ __forceinline__ f32x8 wmma(const f16x16& a, const f16x16& b, const f32x8& c)
{
    return __builtin_amdgcn_wmma_f32_16x16x16_f16_w32(a, b, c);
}
} // namespace wcore

// Global pointers built from the ABI's uint64 fields are cast into address space 1: through a
// generic pointer the compiler emits flat loads/stores, which also count in lgkmcnt, so every wait
// for an LDS result would wait for the in-flight weight/activation prefetches as well.
#define AS1 __attribute__((address_space(1)))
template <typename T> __device__ __forceinline__ AS1 T* gp(uint64_t a) { return (AS1 T*) a; }

// Everything the pipeline reads (pf_moe.hip's view of either of its ABIs; here the engine's only: engine = 1).
struct MoeView
{
    uint64_t sel, wts, x, order, jobs, meta, act, ypart, y, xg, xu;
    uint64_t experts;                                                         // table form
    uint64_t gptr, uptr, dptr, suh_g, suh_u, svh_g, svh_u, suh_d, svh_d;      // engine form
    uint64_t k2g, k2d;                                                        // engine form: int32 [E] bits x 2
    uint32_t rows, topk, E, H, I, ldx, ldy, maxjobs, xld, engine, accumulate, xbf16;
    float limit;
};

__device__ __forceinline__ MoeView view_of(const tf_ds_exl3_pf_args& a)
{
    MoeView v{};
    v.sel = a.ids; v.wts = a.wts; v.x = a.x; v.order = a.order; v.jobs = a.jobs; v.meta = a.meta; v.act = a.xd;
    v.ypart = a.z; v.y = a.out; v.xg = a.xg; v.xu = a.xu;
    v.gptr = a.gate_ptr; v.uptr = a.up_ptr; v.dptr = a.down_ptr; v.suh_g = a.suh_g; v.suh_u = a.suh_u;
    v.svh_g = a.svh_g; v.svh_u = a.svh_u; v.suh_d = a.suh_d; v.svh_d = a.svh_d;
    v.k2g = a.gate_k2; v.k2d = a.down_k2; v.xbf16 = a.x_fmt == 1;
    v.rows = a.r; v.topk = a.slots; v.E = a.e; v.H = a.d; v.I = a.i; v.ldx = a.ldx; v.ldy = a.ldo; v.maxjobs = a.maxjobs;
    v.xld = a.d; v.engine = 1; v.accumulate = a.accumulate; v.limit = a.limit;
    return v;
}

// One expert's trellis and fp16 vectors
struct Ex
{
    uint64_t gt, ut, dt, gs, us, gv, uv, ds, dv;
};
__device__ __forceinline__ Ex expert(const MoeView& v, int e)
{
    Ex x;
    if (!v.engine)
    {
        const AS1 uint64_t* p = gp<const uint64_t>(v.experts) + (size_t) e * 9;   // TfDsExl3ExpertPtrs
        x.gt = p[0]; x.gs = p[1]; x.gv = p[2]; x.ut = p[3]; x.us = p[4]; x.uv = p[5]; x.dt = p[6]; x.ds = p[7]; x.dv = p[8];
    }
    else
    {
        x.gt = gp<const uint64_t>(v.gptr)[e]; x.ut = gp<const uint64_t>(v.uptr)[e]; x.dt = gp<const uint64_t>(v.dptr)[e];
        x.gs = v.suh_g + 2ull * e * v.H; x.us = v.suh_u + 2ull * e * v.H; x.gv = v.svh_g + 2ull * e * v.I;
        x.uv = v.svh_u + 2ull * e * v.I; x.ds = v.suh_d + 2ull * e * v.I; x.dv = v.svh_d + 2ull * e * v.H;
    }
    return x;
}

namespace pfmoe {
using namespace wcore;

constexpr int THREADS = 256;

// The k loop's and epilogues' barriers order LDS only (no global memory passes between the block's waves): release /
// acquire on the local address space, so no GL0 invalidate follows each barrier as __syncthreads()' global one does.
__device__ __forceinline__ void lds_barrier()
{
    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
    __builtin_amdgcn_s_barrier();
    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
}
// NM (template): rows per job, 64 or 128 (the launcher picks 128 when experts average >= 48 rows)
#ifndef PF_KC
#define PF_KC 4
#endif
// k-tiles per staged A chunk (2 or 4; 128-row jobs use 2 to stay inside 64 KB of LDS) and halves
// per staged A row (8 halves of bank padding)
template <int NM> constexpr int kc_of() { return NM == 128 ? 2 : PF_KC; }
template <int NM> constexpr int aw_of() { return kc_of<NM>() * 16 + 8; }
constexpr int CZW = 132;                 // floats per epilogue row (128 + 4 padding)
typedef uint32_t u32x4 __attribute__((ext_vector_type(4)));

struct Job { int e, first, n; };
__device__ __forceinline__ Job load_job(const MoeView& a, int j)
{
    const AS1 int* jb = gp<const int>(a.jobs) + 3 * j;
    return {jb[0], jb[1], jb[2]};
}

// --- exact MUL1 decode ----------------------------------------------------------------------------
// w * 0x83DCD12D mod 2^32 for w < 2^16. PF_U24: as w * 0xDCD12D + ((w * 0x83) << 24) with two
// v_mul_u32_u24 (inline asm: the compiler folds the plain form back into v_mul_lo_u32)
__device__ __forceinline__ uint32_t mul1_prod(uint32_t w)
{
#ifdef PF_U24
    uint32_t t, m;
    asm("v_mul_u32_u24 %0, 0xdcd12d, %1" : "=v"(t) : "v"(w));
    asm("v_mul_u32_u24 %0, 0x83, %1" : "=v"(m) : "v"(w));
    return t + (m << 24);
#else
    return w * 0x83DCD12Du;
#endif
}

// r = the 32 stream bits starting at the first value's state: w0 = r[31:16], w1 = r[31-K:16-K]. PF_PK16: each product
// w * 0x83DCD12D mod 2^32 as w * 0xD12D + ((w * 0x83DC) mod 2^16) << 16 with full-rate 16-bit multiplies (v_mul_lo_u32
// is quarter rate): v_pk_mul_lo_u16 by 0x83DC0000 gives the second term (low lane times 0), v_mad_u32_u16 adds the
// first; w0 read as r's high half (op_sel), so no shift. The same 32-bit products, so the same bits.
#ifndef PF_PK16
#define PF_PK16 1
#endif
__device__ __forceinline__ uint32_t mul1_hi(uint32_t r)    // (r[31:16] * 0x83DCD12D) mod 2^32
{
    uint32_t h, p;
    asm("v_pk_mul_lo_u16 %0, %1, %2" : "=v"(h) : "v"(r), "s"(0x83dc0000u));
    asm("v_mad_u32_u16 %0, %1, %2, %3 op_sel:[1,0,0,0]" : "=v"(p) : "v"(r), "s"(0xd12du), "v"(h));
    return p;
}
__device__ __forceinline__ uint32_t mul1_lo(uint32_t w)    // (w[15:0] * 0x83DCD12D) mod 2^32
{
    uint32_t h, p;
    asm("v_pk_mul_lo_u16 %0, %1, %2 op_sel_hi:[0,1]" : "=v"(h) : "v"(w), "s"(0x83dc0000u));
    asm("v_mad_u32_u16 %0, %1, %2, %3" : "=v"(p) : "v"(w), "s"(0xd12du), "v"(h));
    return p;
}

template <int K>
__device__ __forceinline__ uint32_t dec_pair(uint32_t r)
{
#if PF_PK16
    const uint32_t s0 = __builtin_amdgcn_sad_u8(mul1_hi(r), 0u, 0x64006400u);
    const uint32_t s = __builtin_amdgcn_sad_hi_u8(mul1_lo(__builtin_amdgcn_alignbit(r, r, 16 - K)), 0u, s0);
#else
    const uint32_t s0 = __builtin_amdgcn_sad_u8(mul1_prod(r >> 16), 0u, 0x64006400u);
    const uint32_t s = __builtin_amdgcn_sad_hi_u8(mul1_prod(__builtin_amdgcn_ubfe(r, 16 - K, 16)), 0u, s0);
#endif
    h2 hv = __builtin_bit_cast(h2, s);   // bitcast-ok: u32 to the whole fp16x2, no lane taken
    hv = __builtin_elementwise_fma(hv, __builtin_bit_cast(h2, 0x1eee1eeeu), __builtin_bit_cast(h2, 0xc931c931u));   // bitcast-ok: constants to the whole fp16x2
    return __builtin_bit_cast(uint32_t, hv);   // bitcast-ok: the whole fp16x2 to u32, no lane taken
}

// Per lane (column c = lane & 15, k half h = lane >> 4): the 4 pairs p0 = 32(c%8) + 8q + 4(c/8) + 2h
// (rows 8h + 2q, +1 of column c). Window of pair q starts at stream bit b (mod 256K); with the tile
// staged as S[0..TW-1] = words, S[TW] = word 0 (tail-biting), r = alignbit(S[j], S[j+1], sh).
template <int K>
struct LaneDec
{
    int j[4], sh[4];
    __device__ __forceinline__ explicit LaneDec(int lane)
    {
        constexpr int TB = 256 * K;
        const int col = lane & 15, h = lane >> 4;
        #pragma unroll
        for (int q = 0; q < 4; ++q)
        {
            const int p0 = 32 * (col & 7) + 8 * q + 4 * (col >> 3) + 2 * h;
            int b = ((p0 + 1) * K - 16 + TB) % TB;
            if (b == 0) b = TB;
            j[q] = (b - 1) >> 5;
            sh[q] = 32 - (b - 32 * j[q]);
        }
    }
};

// A wave's B slot: its two decoded tiles as [tile][k half][column][8 halves]. A lane's 16-byte
// write (column c, k half h) and each 16-byte half of a B-fragment read cover 256 contiguous bytes
// per 16 lanes, so neither conflicts on the LDS banks.
typedef _Float16 BSlot[2][2][16][8];

// Raw words of two adjacent tiles (2 TW contiguous words), lane-strided registers
template <int K>
struct Raw2
{
    static constexpr int TW = 8 * K, NW = 2 * TW, NL = (NW + 31) / 32;
    uint32_t w[NL];
    __device__ __forceinline__ void load(const AS1 uint32_t* p, int lane)
    {
        #pragma unroll
        for (int i = 0; i < NL; ++i)
        {
            const int idx = i * 32 + lane;
            w[i] = __builtin_nontemporal_load(p + (idx < NW ? idx : NW - 1));
        }
    }
    // st: [2][TW + 1] words, st[t][TW] = st[t][0], then junk words up to ST_W (absorb out-of-range
    // lanes and the duplicate stores of lanes that do not hold word 0); no branches
    static constexpr int ST_W = 2 * (TW + 1) + 32 * NL;
    __device__ __forceinline__ void stage(uint32_t* st, int lane) const
    {
        #pragma unroll
        for (int i = 0; i < NL; ++i)
        {
            const int idx = i * 32 + lane;
            const int t = idx >= TW, wi = idx - t * TW;
            const int dst = idx < NW ? t * (TW + 1) + wi : 2 * (TW + 1) + idx;
            st[dst] = w[i];
            st[wi == 0 && idx < NW ? t * (TW + 1) + TW : 2 * (TW + 1) + idx] = w[i];
        }
    }
};

// Decode, split so the LDS reads can be issued before the WMMAs of the previous k-tile and the
// arithmetic done after them
template <int K>
struct Words
{
    uint32_t w[2][4][2];
    __device__ __forceinline__ void read(const uint32_t* st, const LaneDec<K>& d)
    {
        constexpr int TW = 8 * K;
        #pragma unroll
        for (int t = 0; t < 2; ++t)
            #pragma unroll
            for (int q = 0; q < 4; ++q) { w[t][q][0] = st[t * (TW + 1) + d.j[q]]; w[t][q][1] = st[t * (TW + 1) + d.j[q] + 1]; }
    }
    __device__ __forceinline__ void decode_store(const LaneDec<K>& d, BSlot& bd, int lane) const
    {
        #pragma unroll
        for (int t = 0; t < 2; ++t)
        {
            uint32_t v[4];
            #pragma unroll
            for (int q = 0; q < 4; ++q) v[q] = dec_pair<K>(__builtin_amdgcn_alignbit(w[t][q][0], w[t][q][1], d.sh[q]));
            *reinterpret_cast<u32x4*>(&bd[t][lane >> 4][lane & 15][0]) = (u32x4) {v[0], v[1], v[2], v[3]};
        }
    }
};

__device__ __forceinline__ f16x16 load_b(const BSlot& bd, int t, int col)
{
    const u32x4 lo = *reinterpret_cast<const u32x4*>(&bd[t][0][col][0]);
    const u32x4 hi = *reinterpret_cast<const u32x4*>(&bd[t][1][col][0]);
    const uint32_t w[8] = {lo.x, lo.y, lo.z, lo.w, hi.x, hi.y, hi.z, hi.w};
    f16x16 b;
    __builtin_memcpy(&b, w, 32);
    return b;
}

// A chunk (KC k-tiles) of NP projections x up to NMAX rows: global row r of projection p at
// (p ? base1 : base0) + r * ld,
// LDS as[p][r][AW]; one coalesced 16-byte segment per (row, proj, part) spread over the block
// ROWS: the rows staged (the job's live row blocks, RB * 16 <= NM), in the NM-row layout
template <int NP, int NM, int ROWS = NM>
struct AChunk
{
    static constexpr int NMAX = NM, KC = kc_of<NM>(), AW = aw_of<NM>(), QP = KC * 2, SEGS = ROWS * NP * QP, SPT = (SEGS + THREADS - 1) / THREADS;
    u32x4 r[SPT];
    __device__ __forceinline__ void load(const AS1 _Float16* base0, const AS1 _Float16* base1, int ld, int n, int c, int tid)
    {
        #pragma unroll
        for (int i = 0; i < SPT; ++i)
        {
            const int s = tid + i * THREADS, q = s % QP, p = (s / QP) % NP, row = s / (NP * QP);
            const int rr = row < n ? row : n - 1;     // rows past n repeat row n - 1 (their outputs are dropped)
            if (SEGS % THREADS == 0 || row < ROWS)
                r[i] = *reinterpret_cast<const AS1 u32x4*>((p ? base1 : base0) + (size_t) rr * ld + c * KC * 16 + q * 8);
        }
    }
    __device__ __forceinline__ void store(_Float16* as, int n, int tid) const
    {
        #pragma unroll
        for (int i = 0; i < SPT; ++i)
        {
            const int s = tid + i * THREADS, q = s % QP, p = (s / QP) % NP, row = s / (NP * QP);
            if (SEGS % THREADS == 0 || row < ROWS) *reinterpret_cast<u32x4*>(as + ((size_t) p * NMAX + row) * AW + q * 8) = r[i];
        }
    }
};

// The k loop shared by gate/up and down. Per k-tile kt a wave: stages the raw words of kt + 1 and
// refills that ring slot with kt + 5; reads its B fragments (kt) and A fragments; reads the decode
// words of kt + 1; issues the WMMAs of kt; decodes kt + 1 into its B slot (LDS is in order per wave,
// so the B reads of kt complete before the writes of kt + 1). One barrier per A chunk. Loads past
// the end are clamped (re-read the last k-tile / chunk) and their decodes land unused, so the
// steady-state loop has no branches. as: [2][NP][NMAX][AW]; aproj: the projection this wave
// multiplies; RB live row blocks. KT % 4 == 0, KC in {2, 4}.
template <int K, int NP, int RB, int NM>
__device__ __forceinline__ void kloop(const AS1 uint32_t* wbase, size_t kstride, int KT, const AS1 _Float16* abase, const AS1 _Float16* abase1, int ald, int n,
                                      _Float16* as, int aproj, uint32_t* st, BSlot& bd, f32x8 (&acc)[2][NM / 16], int tid)
{
    constexpr int NMAX = NM;
    constexpr int KC = kc_of<NM>(), AW = aw_of<NM>();
    static_assert(KC == 2 || KC == 4, "the 4-k-tile unrolled loop needs KC to divide 4");
    const int lane = tid & 31, col = lane & 15;
    const LaneDec<K> ld(lane);
    const int NCH = KT / KC;
    constexpr size_t BUF = (size_t) NP * NMAX * AW;
    Raw2<K> R[4];
    AChunk<NP, NM, (RB * 16 < NM ? RB * 16 : NM)> A;
    #pragma unroll
    for (int v = 0; v < 4; ++v) R[v].load(wbase + (size_t) v * kstride, lane);
    A.load(abase, abase1, ald, n, 0, tid);
    {
        R[0].stage(st, lane);
        R[0].load(wbase + (size_t) min(4, KT - 1) * kstride, lane);
        __builtin_amdgcn_wave_barrier();
        Words<K> w0;
        w0.read(st, ld);
        w0.decode_store(ld, bd, lane);
    }
    A.store(as, n, tid);
    lds_barrier();
    for (int k0 = 0; k0 < KT; k0 += 4)
    {
        #pragma unroll
        for (int v = 0; v < 4; ++v)
        {
            const int kt = k0 + v, c = kt / KC;
            if (v % KC == 0) A.load(abase, abase1, ald, n, min(c + 1, NCH - 1), tid);
            R[(v + 1) & 3].stage(st, lane);
            R[(v + 1) & 3].load(wbase + (size_t) min(kt + 5, KT - 1) * kstride, lane);
            const f16x16 b0 = load_b(bd, 0, col), b1 = load_b(bd, 1, col);
            const _Float16* arow = as + (c & 1) * BUF + ((size_t) aproj * NMAX + col) * AW + (v % KC) * 16;
            Words<K> wn;
            if constexpr (RB <= 4)
            {
                f16x16 af[RB];
                #pragma unroll
                for (int rb = 0; rb < RB; ++rb) af[rb] = load_afrag(arow + rb * 16 * AW);
                __builtin_amdgcn_wave_barrier();
                wn.read(st, ld);
                #pragma unroll
                for (int rb = 0; rb < RB; ++rb)
                {
                    acc[0][rb] = wmma(af[rb], b0, acc[0][rb]);
                    acc[1][rb] = wmma(af[rb], b1, acc[1][rb]);
                }
            }
            else
            {
                // many row blocks: A fragments in groups of 4 so they do not all stay live
                wn.read(st, ld);
                #pragma unroll
                for (int r0 = 0; r0 < RB; r0 += 4)
                {
                    f16x16 af[4];
                    #pragma unroll
                    for (int i = 0; i < 4; ++i) if (r0 + i < RB) af[i] = load_afrag(arow + (r0 + i) * 16 * AW);
                    #pragma unroll
                    for (int i = 0; i < 4; ++i)
                        if (r0 + i < RB)
                        {
                            acc[0][r0 + i] = wmma(af[i], b0, acc[0][r0 + i]);
                            acc[1][r0 + i] = wmma(af[i], b1, acc[1][r0 + i]);
                        }
                }
            }
            wn.decode_store(ld, bd, lane);
            if (v % KC == KC - 1)
            {
                A.store(as + ((c & 1) ^ 1) * BUF, n, tid);
                lds_barrier();
            }
            __builtin_amdgcn_sched_barrier(0);   // keep each k-tile's schedule (and registers) to itself
        }
    }
}

template <int K, int NP, int NM>
__device__ __forceinline__ void kloop_rb(int RB, const AS1 uint32_t* wbase, size_t kstride, int KT, const AS1 _Float16* abase, const AS1 _Float16* abase1, int ald, int n,
                                         _Float16* as, int aproj, uint32_t* st, BSlot& bd, f32x8 (&acc)[2][NM / 16], int tid)
{
#define KL(R_) case R_: kloop<K, NP, R_, NM>(wbase, kstride, KT, abase, abase1, ald, n, as, aproj, st, bd, acc, tid); break;
    if constexpr (NM == 64) { switch (RB) { KL(1) KL(2) KL(3) default: kloop<K, NP, 4, NM>(wbase, kstride, KT, abase, abase1, ald, n, as, aproj, st, bd, acc, tid); } }
    else { switch (RB) { KL(1) KL(2) KL(3) KL(4) KL(5) KL(6) KL(7) default: kloop<K, NP, 8, NM>(wbase, kstride, KT, abase, abase1, ald, n, as, aproj, st, bd, acc, tid); } }
#undef KL
}

// PF_GA (default on): the k loop with each wave's A fragments read straight from global memory (the job's rows are
// L2-resident: every strip block of the job and the waves of a projection read them), PF_GAD k tiles ahead in
// registers, so the loop has no block barrier at all and the waves run free of each other; the B side (raw word ring,
// per-wave staging and decode slots) as kloop's. The same A and B fragments into the same WMMAs in the same k order:
// the same bits. arows: the projection's rows of the job (row stride ald halves).
#ifndef PF_GA_GU
#define PF_GA_GU 0
#endif
#ifndef PF_GA_DOWN
#define PF_GA_DOWN 1
#endif
#ifndef PF_GAD
#define PF_GAD 1
#endif
static_assert(4 % (PF_GAD + 1) == 0, "the A ring's slots repeat every 4 k tiles");
__device__ __forceinline__ f16x16 load_afrag_g(const AS1 _Float16* p)   // 16 halves (32-byte aligned) from global
{
    const AS1 u32x4* q = reinterpret_cast<const AS1 u32x4*>(p);
    const u32x4 lo = q[0], hi = q[1];
    const uint32_t w[8] = {lo.x, lo.y, lo.z, lo.w, hi.x, hi.y, hi.z, hi.w};
    f16x16 a;
    __builtin_memcpy(&a, w, 32);
    return a;
}

template <int K, int RB, int NM>
__device__ __forceinline__ void kloop_g(const AS1 uint32_t* wbase, size_t kstride, int KT, const AS1 _Float16* arows, int ald, int n,
                                        uint32_t* st, BSlot& bd, f32x8 (&acc)[2][NM / 16], int lane)
{
    constexpr int D = PF_GAD;
    const int col = lane & 15;
    const LaneDec<K> ld(lane);
    uint32_t ao[RB];   // this lane's row of each row block (rows past n repeat row n - 1: their outputs are dropped)
    #pragma unroll
    for (int rb = 0; rb < RB; ++rb) { const int r = rb * 16 + col; ao[rb] = (uint32_t) ((r < n ? r : n - 1) * ald); }
    Raw2<K> R[4];
    #pragma unroll
    for (int v = 0; v < 4; ++v) R[v].load(wbase + (size_t) v * kstride, lane);
    f16x16 af[D + 1][RB];
    #pragma unroll
    for (int d = 0; d < D; ++d)
        #pragma unroll
        for (int rb = 0; rb < RB; ++rb) af[d][rb] = load_afrag_g(arows + ao[rb] + min(d, KT - 1) * 16);
    {
        R[0].stage(st, lane);
        R[0].load(wbase + (size_t) min(4, KT - 1) * kstride, lane);
        __builtin_amdgcn_wave_barrier();
        Words<K> w0;
        w0.read(st, ld);
        w0.decode_store(ld, bd, lane);
    }
    for (int k0 = 0; k0 < KT; k0 += 4)
    {
        #pragma unroll
        for (int v = 0; v < 4; ++v)
        {
            const int kt = k0 + v;
            R[(v + 1) & 3].stage(st, lane);
            R[(v + 1) & 3].load(wbase + (size_t) min(kt + 5, KT - 1) * kstride, lane);
            const f16x16 b0 = load_b(bd, 0, col), b1 = load_b(bd, 1, col);
            #pragma unroll
            for (int rb = 0; rb < RB; ++rb) af[(v + D) % (D + 1)][rb] = load_afrag_g(arows + ao[rb] + min(kt + D, KT - 1) * 16);
            __builtin_amdgcn_wave_barrier();
            Words<K> wn;
            wn.read(st, ld);
            #pragma unroll
            for (int rb = 0; rb < RB; ++rb)
            {
                acc[0][rb] = wmma(af[v % (D + 1)][rb], b0, acc[0][rb]);
                acc[1][rb] = wmma(af[v % (D + 1)][rb], b1, acc[1][rb]);
            }
            wn.decode_store(ld, bd, lane);
            __builtin_amdgcn_sched_barrier(0);   // keep each k-tile's schedule (and registers) to itself
        }
    }
}

template <int K, int NM>
__device__ __forceinline__ void kloop_grb(int RB, const AS1 uint32_t* wbase, size_t kstride, int KT, const AS1 _Float16* arows, int ald, int n,
                                          uint32_t* st, BSlot& bd, f32x8 (&acc)[2][NM / 16], int lane)
{
#define KL(R_) case R_: kloop_g<K, R_, NM>(wbase, kstride, KT, arows, ald, n, st, bd, acc, lane); break;
    if constexpr (NM == 64) { switch (RB) { KL(1) KL(2) KL(3) default: kloop_g<K, 4, NM>(wbase, kstride, KT, arows, ald, n, st, bd, acc, lane); } }
    else { switch (RB) { KL(1) KL(2) KL(3) KL(4) KL(5) KL(6) KL(7) default: kloop_g<K, 8, NM>(wbase, kstride, KT, arows, ald, n, st, bd, acc, lane); } }
#undef KL
}

// PF_RAWREG (default on, K <= 5): each lane decodes the 8 consecutive stream values 8 l .. 8 l + 7 of a tile (four
// pairs: tile format value p at row 2 (l % 4) + (j & 1) + 8 ((j >> 1) & 1), column l / 4 + 8 (j >> 2), l = p / 8,
// j = p % 8) from the 3 words holding their windows, loaded straight into registers a few k tiles ahead (wave-uniform
// base + per-lane word offset): no raw-word staging in LDS. The pairs are stored as 4-byte halves into the same B slot
// positions the column-wise decode fills (the same values, the same fragments: the same bits).
#ifndef PF_RAWREG
#define PF_RAWREG 1
#endif
#ifndef PF_RAWREG_DOWN
#define PF_RAWREG_DOWN 0   // measured: down's VGPRs rise 188 -> 219 (8 -> 6 waves a SIMD), 10% slower
#endif
template <int K>
struct LaneRaw
{
    static constexpr int TW = 8 * K, TB = 256 * K;
    uint32_t w[3];       // word offsets in the tile (mod TW)
    int sh;              // the window's alignbit shift
    int row2, colA;      // B slot halves 2 (l % 4), column l / 4
    __device__ __forceinline__ explicit LaneRaw(int lane)
    {
        // the 64-bit window starting at stream bit (8 l + 1) K - 16 (tail-biting): words j .. j + 2, j's bit 32 - sh first
        int b = ((8 * lane + 1) * K - 16 + TB) % TB;
        if (b == 0) b = TB;
        const int j = (b - 1) >> 5;
        sh = 32 - (b - 32 * j);
        #pragma unroll
        for (int i = 0; i < 3; ++i) w[i] = (uint32_t) ((j + i) % TW);
        row2 = 2 * (lane & 3);
        colA = lane >> 2;
    }
};

// Two adjacent tiles' 3 words a lane, in registers
template <int K>
struct RawReg
{
    uint32_t v[2][3];
    __device__ __forceinline__ void load(const AS1 uint32_t* p, const LaneRaw<K>& lr)
    {
        constexpr int TW = 8 * K;
        #pragma unroll
        for (int t = 0; t < 2; ++t)
            #pragma unroll
            for (int i = 0; i < 3; ++i) v[t][i] = __builtin_nontemporal_load(p + t * TW + lr.w[i]);
    }
    // decode both tiles into the wave's B slot
    __device__ __forceinline__ void decode_store(const LaneRaw<K>& lr, BSlot& bd) const
    {
        static_assert(6 * K + 32 <= 64, "PF_RAWREG: four pairs' windows within 64 bits");
        #pragma unroll
        for (int t = 0; t < 2; ++t)
        {
            const uint32_t lo = __builtin_amdgcn_alignbit(v[t][0], v[t][1], lr.sh);
            const uint32_t hi = __builtin_amdgcn_alignbit(v[t][1], v[t][2], lr.sh);
            uint32_t r[4];
            r[0] = lo;
            #pragma unroll
            for (int k = 1; k < 4; ++k) r[k] = __builtin_amdgcn_alignbit(lo, hi, 32 - 2 * k * K);
            #pragma unroll
            for (int k = 0; k < 4; ++k)
                *reinterpret_cast<uint32_t*>(&bd[t][k & 1][lr.colA + 8 * (k >> 1)][lr.row2]) = dec_pair<K>(r[k]);
        }
    }
};

template <int K, int NP, int RB, int NM>
__device__ __forceinline__ void kloop3(const AS1 uint32_t* wbase, size_t kstride, int KT, const AS1 _Float16* abase, const AS1 _Float16* abase1, int ald, int n,
                                       _Float16* as, int aproj, BSlot& bd, f32x8 (&acc)[2][NM / 16], int tid)
{
    constexpr int NMAX = NM;
    constexpr int KC = kc_of<NM>(), AW = aw_of<NM>();
    static_assert(KC == 2 || KC == 4, "the 4-k-tile unrolled loop needs KC to divide 4");
    static_assert(RB <= 4, "kloop3: up to 4 row blocks");
    const int lane = tid & 31, col = lane & 15;
    const LaneRaw<K> lr(lane);
    const int NCH = KT / KC;
    constexpr size_t BUF = (size_t) NP * NMAX * AW;
    RawReg<K> R[4];
    AChunk<NP, NM, (RB * 16 < NM ? RB * 16 : NM)> A;
    #pragma unroll
    for (int v = 0; v < 4; ++v) R[v].load(wbase + (size_t) v * kstride, lr);
    A.load(abase, abase1, ald, n, 0, tid);
    R[0].decode_store(lr, bd);
    R[0].load(wbase + (size_t) min(4, KT - 1) * kstride, lr);
    A.store(as, n, tid);
    lds_barrier();
    for (int k0 = 0; k0 < KT; k0 += 4)
    {
        #pragma unroll
        for (int v = 0; v < 4; ++v)
        {
            const int kt = k0 + v, c = kt / KC;
            if (v % KC == 0) A.load(abase, abase1, ald, n, min(c + 1, NCH - 1), tid);
            const f16x16 b0 = load_b(bd, 0, col), b1 = load_b(bd, 1, col);
            const _Float16* arow = as + (c & 1) * BUF + ((size_t) aproj * NMAX + col) * AW + (v % KC) * 16;
            f16x16 af[RB];
            #pragma unroll
            for (int rb = 0; rb < RB; ++rb) af[rb] = load_afrag(arow + rb * 16 * AW);
            #pragma unroll
            for (int rb = 0; rb < RB; ++rb)
            {
                acc[0][rb] = wmma(af[rb], b0, acc[0][rb]);
                acc[1][rb] = wmma(af[rb], b1, acc[1][rb]);
            }
            R[(v + 1) & 3].decode_store(lr, bd);   // k tile kt + 1 (LDS is in order per wave: kt's B reads first)
            R[(v + 1) & 3].load(wbase + (size_t) min(kt + 5, KT - 1) * kstride, lr);
            if (v % KC == KC - 1)
            {
                A.store(as + ((c & 1) ^ 1) * BUF, n, tid);
                lds_barrier();
            }
            __builtin_amdgcn_sched_barrier(0);
        }
    }
}

template <int K, int RB, int NM>
__device__ __forceinline__ void kloop_g3(const AS1 uint32_t* wbase, size_t kstride, int KT, const AS1 _Float16* arows, int ald, int n,
                                         BSlot& bd, f32x8 (&acc)[2][NM / 16], int lane)
{
    constexpr int D = PF_GAD;
    const int col = lane & 15;
    const LaneRaw<K> lr(lane);
    uint32_t ao[RB];
    #pragma unroll
    for (int rb = 0; rb < RB; ++rb) { const int r = rb * 16 + col; ao[rb] = (uint32_t) ((r < n ? r : n - 1) * ald); }
    RawReg<K> R[4];
    #pragma unroll
    for (int v = 0; v < 4; ++v) R[v].load(wbase + (size_t) v * kstride, lr);
    f16x16 af[D + 1][RB];
    #pragma unroll
    for (int d = 0; d < D; ++d)
        #pragma unroll
        for (int rb = 0; rb < RB; ++rb) af[d][rb] = load_afrag_g(arows + ao[rb] + min(d, KT - 1) * 16);
    R[0].decode_store(lr, bd);
    R[0].load(wbase + (size_t) min(4, KT - 1) * kstride, lr);
    for (int k0 = 0; k0 < KT; k0 += 4)
    {
        #pragma unroll
        for (int v = 0; v < 4; ++v)
        {
            const int kt = k0 + v;
            const f16x16 b0 = load_b(bd, 0, col), b1 = load_b(bd, 1, col);
            #pragma unroll
            for (int rb = 0; rb < RB; ++rb) af[(v + D) % (D + 1)][rb] = load_afrag_g(arows + ao[rb] + min(kt + D, KT - 1) * 16);
            #pragma unroll
            for (int rb = 0; rb < RB; ++rb)
            {
                acc[0][rb] = wmma(af[v % (D + 1)][rb], b0, acc[0][rb]);
                acc[1][rb] = wmma(af[v % (D + 1)][rb], b1, acc[1][rb]);
            }
            R[(v + 1) & 3].decode_store(lr, bd);
            R[(v + 1) & 3].load(wbase + (size_t) min(kt + 5, KT - 1) * kstride, lr);
            __builtin_amdgcn_sched_barrier(0);
        }
    }
}

// Gate/up: block = (job, strip of 128 columns of I). Waves 0-3 gate, 4-7 up; wave owns column tiles
// 2(w&3), 2(w&3)+1 of the strip for every row of the job. Epilogue per row block: H128 * svh on
// gate and up, DeepSeek SwiGLU with clamps, routing weight (table form only), down's suh, down's
// input H128 -> act.
template <int K, int NM>
__device__ void gu_body(const MoeView& a)
{
    constexpr int TW = 8 * K, NMAX = NM, RBM = NM / 16;
    constexpr int AS_B = PF_GA_GU ? 0 : 2 * 2 * NMAX * aw_of<NM>() * 2, CZ_B = 2 * 16 * CZW * 4;
    __shared__ __attribute__((aligned(16))) unsigned char smem[AS_B > CZ_B ? AS_B : CZ_B];
    __shared__ __attribute__((aligned(16))) BSlot bds[8];
    __shared__ __attribute__((aligned(16))) uint32_t sts[8][Raw2<K>::ST_W];
    __shared__ int s_asg[NMAX];
    float (*cz)[16][CZW] = reinterpret_cast<float (*)[16][CZW]>(smem);   // [proj][row][col]

    const int tid = threadIdx.x, wave = __builtin_amdgcn_readfirstlane(tid >> 5), lane = tid & 31;
    const int strips = (int) (a.I / 128);
    const int job = (int) blockIdx.x / strips, strip = (int) blockIdx.x % strips;
    const Job jb = load_job(a, job);
    if (jb.n == 0) return;
    if (a.k2g && gp<const int>(a.k2g)[jb.e] != 2 * K) return;   // another launch's bits
    const int n = jb.n, RB = (n + 15) >> 4;
    const Ex ep = expert(a, jb.e);
    if (tid < NMAX) s_asg[tid] = tid < n ? gp<const int>(a.order)[jb.first + tid] : -1;

    const int m = wave >> 2, wc = wave & 3;
    const int NT = (int) (a.I / 16), KT = (int) (a.H / 16);
    const AS1 uint32_t* wbase = (m ? gp<const uint32_t>(ep.ut) : gp<const uint32_t>(ep.gt)) + (size_t) (strip * 8 + 2 * wc) * TW;
    const AS1 _Float16* xg = gp<const _Float16>(a.xg) + (size_t) jb.first * a.xld;   // rotated rows, sorted order
    const AS1 _Float16* xu = gp<const _Float16>(a.xu) + (size_t) jb.first * a.xld;
    f32x8 acc[2][RBM];
    #pragma unroll
    for (int t = 0; t < 2; ++t)
        #pragma unroll
        for (int rb = 0; rb < RBM; ++rb) acc[t][rb] = (f32x8) {0, 0, 0, 0, 0, 0, 0, 0};
    if constexpr (PF_RAWREG && K <= 5 && NM == 64 && !PF_GA_GU)
    {
        switch (RB)
        {
            case 1: kloop3<K, 2, 1, NM>(wbase, (size_t) NT * TW, KT, xg, xu, (int) a.xld, n, reinterpret_cast<_Float16*>(smem), m, bds[wave], acc, tid); break;
            case 2: kloop3<K, 2, 2, NM>(wbase, (size_t) NT * TW, KT, xg, xu, (int) a.xld, n, reinterpret_cast<_Float16*>(smem), m, bds[wave], acc, tid); break;
            case 3: kloop3<K, 2, 3, NM>(wbase, (size_t) NT * TW, KT, xg, xu, (int) a.xld, n, reinterpret_cast<_Float16*>(smem), m, bds[wave], acc, tid); break;
            default: kloop3<K, 2, 4, NM>(wbase, (size_t) NT * TW, KT, xg, xu, (int) a.xld, n, reinterpret_cast<_Float16*>(smem), m, bds[wave], acc, tid);
        }
    }
    else if constexpr (PF_GA_GU)
        kloop_grb<K, NM>(RB, wbase, (size_t) NT * TW, KT, m ? xu : xg, (int) a.xld, n, sts[wave], bds[wave], acc, lane);
    else
        kloop_rb<K, 2, NM>(RB, wbase, (size_t) NT * TW, KT, xg, xu, (int) a.xld, n, reinterpret_cast<_Float16*>(smem), m, sts[wave], bds[wave], acc, tid);
    if constexpr (PF_GA_GU) lds_barrier();   // the epilogue's first LDS writes follow every wave's s_asg read

    // Epilogue, one row block at a time through LDS (aliases the A buffers; kloop ends on a barrier)
    const AS1 _Float16* gsv = gp<const _Float16>(ep.gv) + strip * 128;
    const AS1 _Float16* usv = gp<const _Float16>(ep.uv) + strip * 128;
    const AS1 _Float16* dsu = gp<const _Float16>(ep.ds) + strip * 128;
    const float L = a.limit;
    #pragma unroll
    for (int rb = 0; rb < RBM; ++rb)
    {
        if (rb >= RB) break;
        #pragma unroll
        for (int t = 0; t < 2; ++t)
            #pragma unroll
            for (int r = 0; r < 8; ++r)
                cz[m][2 * r + (lane >> 4)][(2 * wc + t) * 16 + (lane & 15)] = acc[t][rb][r];
        lds_barrier();
        for (int i = wave; i < 16; i += 8)
        {
            const int row = rb * 16 + i;
            if (row >= n) break;
            const float w = a.engine ? 1.0f : gp<const float>(a.wts)[s_asg[row]];   // engine: weight after w2
            float gv[4], uv[4], v[4];
            #pragma unroll
            for (int q = 0; q < 4; ++q) { gv[q] = cz[0][i][lane * 4 + q]; uv[q] = cz[1][i][lane * 4 + q]; }
            fwht128(gv, lane);
            fwht128(uv, lane);
            #pragma unroll
            for (int q = 0; q < 4; ++q)
            {
                float gg = gv[q] * (HAD_SCALE * (float) gsv[lane * 4 + q]);
                float uu = uv[q] * (HAD_SCALE * (float) usv[lane * 4 + q]);
                uu = fminf(fmaxf(uu, -L), L);
                gg = fminf(gg, L);
                v[q] = (gg / (1.0f + expf(-gg))) * uu * w * (float) dsu[lane * 4 + q];
            }
            fwht128(v, lane);
            AS1 _Float16* out = gp<_Float16>(a.act) + (size_t) (jb.first + row) * a.I + strip * 128 + lane * 4;
            #pragma unroll
            for (int q = 0; q < 4; ++q) out[q] = sat_f16(v[q] * HAD_SCALE);
        }
        lds_barrier();
    }
}

// Down: block = (job, pair of 128-column strips of H). Wave w owns column tiles 2w, 2w+1 of the
// pair (strip pair*2 + w/4). A = act rows of the job (sorted positions). Epilogue: H128 * svh into
// ypart[assignment] (fp32).
template <int K, int NM>
__device__ void down_body(const MoeView& a)
{
    constexpr int TW = 8 * K, NMAX = NM, RBM = NM / 16;
    constexpr bool GA = PF_GA_DOWN && NM == 64;   // 128-row jobs keep the LDS staging (global A spills there)
    constexpr int AS_B = GA ? 0 : 2 * NMAX * aw_of<NM>() * 2, CZ_B = 16 * 2 * CZW * 4;
    __shared__ __attribute__((aligned(16))) unsigned char smem[AS_B > CZ_B ? AS_B : CZ_B];
    __shared__ __attribute__((aligned(16))) BSlot bds[8];
    __shared__ __attribute__((aligned(16))) uint32_t sts[8][Raw2<K>::ST_W];
    __shared__ int s_asg[NMAX];
    float (*cz)[2][CZW] = reinterpret_cast<float (*)[2][CZW]>(smem);   // [row][strip][col]

    const int tid = threadIdx.x, wave = __builtin_amdgcn_readfirstlane(tid >> 5), lane = tid & 31;
    const int pairs = (int) (a.H / 256);
    const int job = (int) blockIdx.x / pairs, sp = (int) blockIdx.x % pairs;
    const Job jb = load_job(a, job);
    if (jb.n == 0) return;
    if (a.k2d && gp<const int>(a.k2d)[jb.e] != 2 * K) return;   // another launch's bits
    const int n = jb.n, RB = (n + 15) >> 4;
    const Ex ep = expert(a, jb.e);
    if (tid < NMAX) s_asg[tid] = tid < n ? gp<const int>(a.order)[jb.first + tid] : -1;

    const int NT = (int) (a.H / 16), KT = (int) (a.I / 16);
    const AS1 uint32_t* wbase = gp<const uint32_t>(ep.dt) + (size_t) (sp * 16 + 2 * wave) * TW;
    const AS1 _Float16* act = gp<const _Float16>(a.act) + (size_t) jb.first * a.I;
    f32x8 acc[2][RBM];
    #pragma unroll
    for (int t = 0; t < 2; ++t)
        #pragma unroll
        for (int rb = 0; rb < RBM; ++rb) acc[t][rb] = (f32x8) {0, 0, 0, 0, 0, 0, 0, 0};
    if constexpr (GA && PF_RAWREG_DOWN && K <= 5)
    {
        switch (RB)
        {
            case 1: kloop_g3<K, 1, NM>(wbase, (size_t) NT * TW, KT, act, (int) a.I, n, bds[wave], acc, lane); break;
            case 2: kloop_g3<K, 2, NM>(wbase, (size_t) NT * TW, KT, act, (int) a.I, n, bds[wave], acc, lane); break;
            case 3: kloop_g3<K, 3, NM>(wbase, (size_t) NT * TW, KT, act, (int) a.I, n, bds[wave], acc, lane); break;
            default: kloop_g3<K, 4, NM>(wbase, (size_t) NT * TW, KT, act, (int) a.I, n, bds[wave], acc, lane);
        }
    }
    else if constexpr (GA)
        kloop_grb<K, NM>(RB, wbase, (size_t) NT * TW, KT, act, (int) a.I, n, sts[wave], bds[wave], acc, lane);
    else
        kloop_rb<K, 1, NM>(RB, wbase, (size_t) NT * TW, KT, act, act, (int) a.I, n, reinterpret_cast<_Float16*>(smem), 0, sts[wave], bds[wave], acc, tid);
    if constexpr (GA) lds_barrier();

    const AS1 _Float16* dsv = gp<const _Float16>(ep.dv) + sp * 256;
    #pragma unroll
    for (int rb = 0; rb < RBM; ++rb)
    {
        if (rb >= RB) break;
        #pragma unroll
        for (int t = 0; t < 2; ++t)
            #pragma unroll
            for (int r = 0; r < 8; ++r)
                cz[2 * r + (lane >> 4)][wave >> 2][((wave & 3) * 2 + t) * 16 + (lane & 15)] = acc[t][rb][r];
        lds_barrier();
        for (int task = wave; task < 32; task += 8)
        {
            const int i = task >> 1, s2 = task & 1, row = rb * 16 + i;
            if (row < n)
            {
                float v[4];
                #pragma unroll
                for (int q = 0; q < 4; ++q) v[q] = cz[i][s2][lane * 4 + q];
                fwht128(v, lane);
                AS1 float* out = gp<float>(a.ypart) + (size_t) s_asg[row] * a.H + sp * 256 + s2 * 128 + lane * 4;
                #pragma unroll
                for (int q = 0; q < 4; ++q) out[q] = v[q] * (HAD_SCALE * (float) dsv[s2 * 128 + lane * 4 + q]);
            }
        }
        lds_barrier();
    }
}

// Routing: per-expert counts and offsets (one block), then one wave per expert collects its
// assignments in order (ballot prefix) and emits ceil(n / nmax) jobs of near-equal size.
// meta: off[E + 1] at 0, job offsets at 1025.
__device__ void count_body(const MoeView& a, int nmax)
{
    __shared__ int cnt[1024];
    const int tid = threadIdx.x;
    const int nas = (int) (a.rows * a.topk), E = (int) a.E;
    const AS1 int* sel = gp<const int>(a.sel);
    for (int e = tid; e < E; e += 1024) cnt[e] = 0;
    __syncthreads();
    for (int i = tid; i < nas; i += 1024) { const int e = sel[i]; if (e >= 0 && e < E) atomicAdd(&cnt[e], 1); }
    __syncthreads();
    AS1 int* meta = gp<int>(a.meta);
    if (tid == 0)
    {
        int o = 0, j = 0;
        for (int e = 0; e < E; ++e) { meta[e] = o; meta[1025 + e] = j; o += cnt[e]; j += (cnt[e] + nmax - 1) / nmax; }
        meta[E] = o; meta[1025 + E] = j;
    }
    __syncthreads();
    AS1 int* jobs = gp<int>(a.jobs);
    for (int j = meta[1025 + E] + tid; j < (int) a.maxjobs; j += 1024) { jobs[3 * j] = 0; jobs[3 * j + 1] = 0; jobs[3 * j + 2] = 0; }
}

__device__ void place_body(const MoeView& a, int nmax)
{
    const int lane = threadIdx.x & 31;
    const int e = blockIdx.x * 8 + (threadIdx.x >> 5);
    const int E = (int) a.E;
    if (e >= E) return;
    const AS1 int* meta = gp<const int>(a.meta);
    const int o0 = meta[e], o1 = meta[e + 1];
    if (o0 == o1) return;
    const int nas = (int) (a.rows * a.topk);
    const AS1 int* sel = gp<const int>(a.sel);
    AS1 int* order = gp<int>(a.order);
    int pos = o0;
    for (int base = 0; base < nas && pos < o1; base += 32)
    {
        const int i = base + lane;
        const bool hit = i < nas && sel[i] == e;
        const unsigned long long msk = __ballot(hit);
        if (hit) order[pos + __popcll(msk & ((1ull << lane) - 1))] = i;
        pos += __popcll(msk);
    }
    const int n = o1 - o0, nj = (n + nmax - 1) / nmax, j0 = meta[1025 + e];
    AS1 int* jobs = gp<int>(a.jobs);
    for (int j = lane; j < nj; j += 32)
    {
        const int base = n / nj, rem = n % nj;
        const int first = o0 + j * base + min(j, rem), cnt = base + (j < rem);
        jobs[3 * (j0 + j)] = e; jobs[3 * (j0 + j) + 1] = first; jobs[3 * (j0 + j) + 2] = cnt;
    }
}

// Input rotation (same arithmetic as w_moe_pf.hip): xg/xu[p] = fp16(H128(x_row * suh_{g,u}(e)) /
// sqrt(128)) for sorted position p (order[p] = assignment). One block per position: the routing
// lookups and the expert's pointers once per row, each wave one 128-group at a time for both
// projections (x read once). x fp16, or bf16 in the engine form with x_fmt 1.
__device__ void rot_body(const MoeView& a)
{
    const int lane = threadIdx.x & 31, wave = threadIdx.x >> 5;
    const long p = blockIdx.x;
    if (p >= (long) a.rows * a.topk) return;
    const int asg = gp<const int>(a.order)[p];
    const Ex ep = expert(a, gp<const int>(a.sel)[asg]);
    const AS1 _Float16* gs = gp<const _Float16>(ep.gs);
    const AS1 _Float16* us = gp<const _Float16>(ep.us);
    const size_t xrow = (size_t) (asg / (int) a.topk) * a.ldx;
    AS1 _Float16* og = gp<_Float16>(a.xg) + (size_t) p * a.xld;
    AS1 _Float16* ou = gp<_Float16>(a.xu) + (size_t) p * a.xld;
    const int G = (int) (a.H / 128);
    for (int g = wave; g < G; g += 8)
    {
        const int k = g * 128 + lane * 4;
        float vg[4], vu[4], xv4[4];
        if (a.xbf16)
        {
            typedef uint32_t u32x2 __attribute__((ext_vector_type(2)));
            const u32x2 raw = *reinterpret_cast<const AS1 u32x2*>(gp<const uint16_t>(a.x) + xrow + k);
            xv4[0] = __builtin_bit_cast(float, raw.x << 16); xv4[1] = __builtin_bit_cast(float, raw.x & 0xffff0000u);   // bitcast-ok: bf16 bits widened to fp32, u32 to float
            xv4[2] = __builtin_bit_cast(float, raw.y << 16); xv4[3] = __builtin_bit_cast(float, raw.y & 0xffff0000u);   // bitcast-ok: bf16 bits widened to fp32, u32 to float
        }
        else
        {
            #pragma unroll
            for (int q = 0; q < 4; ++q) xv4[q] = (float) gp<const _Float16>(a.x)[xrow + k + q];
        }
        #pragma unroll
        for (int q = 0; q < 4; ++q)
        {
            const float xv = xv4[q];
            vg[q] = xv * (float) gs[k + q];
            vu[q] = xv * (float) us[k + q];
        }
        fwht128(vg, lane);
        fwht128(vu, lane);
        #pragma unroll
        for (int q = 0; q < 4; ++q)
        {
            og[k + q] = sat_f16(vg[q] * HAD_SCALE);
            ou[k + q] = sat_f16(vu[q] * HAD_SCALE);
        }
    }
}

// Combine: y[r] = (y[r] if accumulate else 0) then, over the row's slots in slot order (slots with
// an expert outside [0, E) skipped): table form y += ypart (weight already applied before w2, as
// w_moe.hip), engine form y = fma(w, ypart, y). One thread per 4 columns (16-byte accesses).
__device__ void combine_body(const MoeView& a)
{
    typedef float f32x4 __attribute__((ext_vector_type(4)));
    const int H4 = (int) (a.H / 4);
    const size_t total = (size_t) a.rows * H4;
    const AS1 int* sel = gp<const int>(a.sel);
    const AS1 float* wts = gp<const float>(a.wts);
    for (size_t i = (size_t) blockIdx.x * 256 + threadIdx.x; i < total; i += (size_t) gridDim.x * 256)
    {
        const int r = (int) (i / H4), c = (int) (i % H4) * 4;
        AS1 f32x4* yo = reinterpret_cast<AS1 f32x4*>(gp<float>(a.y) + (size_t) r * a.ldy + c);
        f32x4 s = a.accumulate ? *yo : (f32x4) {0, 0, 0, 0};
        for (int k = 0; k < (int) a.topk; ++k)
        {
            const int asg = r * (int) a.topk + k;
            const int e = sel[asg];
            if (e < 0 || e >= (int) a.E) continue;
            const f32x4 y = *reinterpret_cast<const AS1 f32x4*>(gp<const float>(a.ypart) + (size_t) asg * a.H + c);
            if (a.engine)
            {
                const float w = wts[asg];
                #pragma unroll
                for (int q = 0; q < 4; ++q) s[q] = __builtin_fmaf(w, y[q], s[q]);
            }
            else s += y;
        }
        *yo = s;
    }
}

} // namespace pfmoe

// ---- the kit's entries (abi.h tf_ds_exl3_pf_args; registry.json exl3.pf_experts.*: gu / down by {k2, cb, nm}) ----
extern "C" __global__ __launch_bounds__(1024) void tf_ds_exl3_pf_experts_count(tf_ds_exl3_pf_args a) { pfmoe::count_body(view_of(a), (int) a.nmax); }
extern "C" __global__ __launch_bounds__(256) void tf_ds_exl3_pf_experts_place(tf_ds_exl3_pf_args a) { pfmoe::place_body(view_of(a), (int) a.nmax); }
extern "C" __global__ __launch_bounds__(256) void tf_ds_exl3_pf_experts_rot(tf_ds_exl3_pf_args a) { pfmoe::rot_body(view_of(a)); }
extern "C" __global__ __launch_bounds__(256) void tf_ds_exl3_pf_experts_combine(tf_ds_exl3_pf_args a) { pfmoe::combine_body(view_of(a)); }
#define PF_EXPERTS_ENTRY(KB, K2B) \
    extern "C" __global__ __launch_bounds__(pfmoe::THREADS) void tf_ds_exl3_pf_experts_gu64_k##K2B(tf_ds_exl3_pf_args a) { pfmoe::gu_body<KB, 64>(view_of(a)); } \
    extern "C" __global__ __launch_bounds__(pfmoe::THREADS) void tf_ds_exl3_pf_experts_down64_k##K2B(tf_ds_exl3_pf_args a) { pfmoe::down_body<KB, 64>(view_of(a)); } \
    extern "C" __global__ __launch_bounds__(pfmoe::THREADS) void tf_ds_exl3_pf_experts_gu128_k##K2B(tf_ds_exl3_pf_args a) { pfmoe::gu_body<KB, 128>(view_of(a)); } \
    extern "C" __global__ __launch_bounds__(pfmoe::THREADS) void tf_ds_exl3_pf_experts_down128_k##K2B(tf_ds_exl3_pf_args a) { pfmoe::down_body<KB, 128>(view_of(a)); }
PF_EXPERTS_ENTRY(2, 4)
PF_EXPERTS_ENTRY(3, 6)
PF_EXPERTS_ENTRY(4, 8)
PF_EXPERTS_ENTRY(5, 10)
PF_EXPERTS_ENTRY(6, 12)
